<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <attribution
        android:tag="push_to_talk_audio"
        android:label="@string/attribution_push_to_talk_audio" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name="com.erwann.voxal.app.MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: https://ptt.voxal.app/?room=… opens the app directly.
                 Requires a matching assetlinks.json at ptt.voxal.app/.well-known/assetlinks.json
                 containing the SHA-256 certificate fingerprint of the release signing key. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="ptt.voxal.app" />
            </intent-filter>

        </activity>

        <service
            android:name="com.erwann.voxal.app.PushToTalkService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Camera share. Capacitor's BridgeWebChromeClient maps the WebView's
         RESOURCE_VIDEO_CAPTURE request onto a runtime CAMERA request, but a
         permission missing from the manifest is auto-denied — which is why
         getUserMedia({video}) failed silently in the app before this line.

         Note the foreground service above stays foregroundServiceType="microphone":
         capture is paused when the app backgrounds (setLocalCameraSuspended in
         main.js), so no camera foreground service is needed. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- required="false" on both: Voxal is a voice app first, and Play must not
         hide it from devices without a camera. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
</manifest>
