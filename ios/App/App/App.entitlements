<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the VoxalBroadcast extension: ReplayKit runs it in its own
	     process, and the App Group container is where the frame socket lives. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.erwann.voxal.app</string>
	</array>
	<key>com.apple.developer.push-to-talk</key>
	<true/>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:ptt.voxal.app</string>
	</array>
</dict>
</plist>
