{
  "name": "voxal",
  "version": "0.9.8",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "prepare": "node scripts/install-hooks.mjs",
    "lint": "eslint .",
    "test": "npm run test:rust && npm run test:api && npm run test:e2e",
    "test:rust": "cd src-tauri && cargo test",
    "test:e2e": "NODE_OPTIONS=--disable-warning=DEP0205 playwright test --project=unit",
    "test:gl": "NODE_OPTIONS=--disable-warning=DEP0205 playwright test --project=gl",
    "test:mesh": "NODE_OPTIONS=--disable-warning=DEP0205 playwright test --project=mesh",
    "test:bench": "NODE_OPTIONS=--disable-warning=DEP0205 playwright test --project=bench --workers=1",
    "test:api": "node --test \"api/*.test.js\"",
    "test:api:coverage": "node -e \"require('fs').mkdirSync('coverage-api',{recursive:true})\" && node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage-api/lcov.info \"api/*.test.js\"",
    "coverage:report": "node scripts/coverage-report.mjs",
    "bench:audio": "node scripts/gen-bench-audio.mjs",
    "bench:report": "node scripts/bench-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mediapipe/tasks-vision": "1.2.2",
    "@playwright/test": "^1.65.0",
    "@tauri-apps/cli": "^2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "monocart-coverage-reports": "^3.2.0",
    "peer": "^1.0.2",
    "three": "0.187.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-updater": "^8.54.2"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
